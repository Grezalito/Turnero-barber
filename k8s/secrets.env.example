# Copiar a k8s/secrets.env (ignorado por git) y completar TODOS los valores.
# Generar valores aleatorios con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Valores vacíos a propósito: la API no arranca si faltan (fail-fast).

# Sólo letras y números: va dentro de la URL de conexión (DATABASE_URL).
POSTGRES_PASSWORD=

# >= 32 caracteres. La API no arranca sin él.
JWT_SECRET=

MP_WEBHOOK_SECRET=

# Obligatorias: la API no arranca si faltan o si la contraseña es el placeholder.
SUPERADMIN_DNI=00000000
SUPERADMIN_PASSWORD=
