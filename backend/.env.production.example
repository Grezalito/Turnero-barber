# ==============================================================================
# TURNERO BARBER CRAFT - VARIABLES DE ENTORNO DE PRODUCCIÓN (/backend)
# ==============================================================================

# 1. Base de Datos PostgreSQL (Supabase / Railway / Neon / RDS)
# Usar connection pooling (?pgbouncer=true&connection_limit=1) en entornos serverless
DATABASE_URL="postgresql://postgres:TU_PASSWORD_SEGURO@db.tu-proyecto.supabase.co:5432/postgres?schema=public"

# 2. Seguridad y Autenticación JWT (DNI + Password)
JWT_SECRET="reemplazar_por_clave_secreta_de_64_caracteres_aleatorios_en_produccion"
JWT_EXPIRES_IN="7d"

# 3. Puerto HTTP del Servidor NestJS y URL del Frontend (CORS + Redirección MP)
PORT=3000
FRONTEND_URL="https://turnero-barber.vercel.app"

# 4. Mercado Pago - Cuenta Central de la Plataforma (100% Seña Fija $2.000 ARS)
MP_ACCESS_TOKEN="APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000"
MP_WEBHOOK_URL="https://api.turnero-barber.com/payments/webhook"

# 5. Notificaciones por Email (Nodemailer SMTP + Adjunto .ICS)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_123456789_tu_api_key_smtp"
SMTP_FROM="Turnero Barber Craft <no-reply@turnero-barber.com>"

# 6. Credenciales Iniciales de SuperAdmin (para seed inicial en producción)
SUPERADMIN_DNI="00000000"
SUPERADMIN_PASSWORD="CambiarPasswordSuperAdminProd2026!"
