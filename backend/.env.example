# ==============================================================================
# Turnazo backend — variables de entorno (desarrollo local)
# Copiar a backend/.env y reemplazar los valores. TODOS los valores de este archivo son falsos.
# ==============================================================================

# --- Runtime -------------------------------------------------------------------
# "production" endurece CORS y desactiva los fallbacks de desarrollo.
NODE_ENV="development"
PORT=3000

# --- Base de datos -------------------------------------------------------------
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"

# --- Auth (JWT) ----------------------------------------------------------------
# Obligatorio (>= 32 caracteres). La API no arranca sin él. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- URLs públicas (CORS, links de reserva, back_urls de Mercado Pago) ----------
# FRONTEND_URL admite varios orígenes separados por coma; el primero se usa para armar links.
# En producción, si no se define, CORS bloquea todo origen de navegador.
FRONTEND_URL="http://localhost:5173"
# Fallback de FRONTEND_URL (opcional).
PUBLIC_APP_URL=""

# --- Mercado Pago ---------------------------------------------------------------
# El valor "...CENTRAL-PLATFORM-TOKEN" activa el modo simulado de pagos para desarrollo.
MP_ACCESS_TOKEN="APP_USR-CENTRAL-PLATFORM-TOKEN"
# URL pública del webhook (notification_url), ej. https://api.example.com/payments/webhook.
# Vacío = no se envía en la preferencia.
MP_WEBHOOK_URL=""
# Vacío = todos los webhooks se rechazan por firma inválida.
MP_WEBHOOK_SECRET=""
MP_WEBHOOK_TOLERANCE_SECONDS=300

# --- SuperAdmin (seed) ------------------------------------------------------------
# Obligatorias para `npm run prisma:seed`: el seed falla si faltan o si la contraseña
# sigue siendo el placeholder. No hay contraseña por defecto.
SUPERADMIN_DNI="00000000"
SUPERADMIN_PASSWORD="CAMBIAR_ESTA_CONTRASENA"

# --- Email (SMTP) -----------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"

# --- Web Push (PWA) ---------------------------------------------------------------
# Generar el par con: npx web-push generate-vapid-keys
# Sin estas claves el canal push queda deshabilitado (los recordatorios siguen por email).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@example.com"

# --- Privacidad -------------------------------------------------------------------
# Días de retención de datos personales antes de anonimizarlos/purgarlos (default 30).
PII_RETENTION_DAYS=30
